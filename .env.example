# Feishu self-built app credentials.
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# Security gate. Keep FEISHU_ALLOW_ALL=false for real use.
# First message from an unauthorized user will reply with open_id/user_id/chat_id
# so you can copy the id into the allow list.
FEISHU_ALLOW_ALL=false
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_ALLOWED_USER_IDS=
FEISHU_ALLOWED_UNION_IDS=
FEISHU_ALLOWED_CHAT_IDS=

# Codex process settings.
# Windows example: C:\Users\Administrator\Documents\projects
# macOS example: /Users/you/projects
CODEX_ROOT=
CODEX_CWD=

# Leave empty to auto-detect: codex.cmd on Windows, codex on macOS/Linux.
CODEX_COMMAND=
CODEX_TRANSPORT=exec
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL=on-request
CODEX_ENABLE_SEARCH=false
CODEX_EXTRA_ARGS=

# Bridge behavior.
SESSION_IDLE_MINUTES=120
OUTPUT_FLUSH_MS=1500
OUTPUT_CHUNK_CHARS=3500
POST_CHUNK_CHARS=2800
EXEC_HEARTBEAT_MS=120000
EXEC_TIMEOUT_MINUTES=30
SHOW_COMMAND_PROGRESS=false
SHOW_TURN_PROGRESS=true
AUTO_SEND_IMAGES=true
MAX_IMAGES_PER_RUN=5
MAX_IMAGE_MB=10
LOG_LEVEL=info
